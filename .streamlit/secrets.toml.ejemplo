# EJEMPLO de secrets.toml. Este archivo SÍ se sube a GitHub porque no trae
# datos reales. Para usarlo: cópialo como .streamlit/secrets.toml y cambia los
# valores. En Streamlit Cloud, pega el contenido en "Advanced settings -> Secrets".
#
# Importante en TOML: las claves sueltas (como TELEGRAM_TOKEN) van ARRIBA,
# antes de cualquier sección entre corchetes [ ].

# --- Telegram ---
TELEGRAM_TOKEN = "pega_aqui_tu_token"
TELEGRAM_CHAT_ID = "pega_aqui_tu_chat_id"

# --- Gemini (la IA que lee las imágenes de las facturas) ---
GEMINI_API_KEY = "pega_aqui_tu_clave_de_gemini"

# --- Usuarios de prueba ---
[usuarios.auxiliar]
contrasena = "inventa-una-contrasena"
rol = "auxiliar"
nombre = "Auxiliar de Recursos Financieros"

[usuarios.jefe]
contrasena = "inventa-otra-contrasena"
rol = "jefe"
nombre = "Jefe de Recursos Financieros"
